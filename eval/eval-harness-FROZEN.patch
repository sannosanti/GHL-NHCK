+      aggregate(allRuns.filter(r => r.model === a.label && r.mode === mode),
+        { frequencies: gold.stratum_frequencies, monthlyVolume: volume, bootstrap,
+          pendingPaymentDisponible: gold.pending_payment_disponible === true }));
